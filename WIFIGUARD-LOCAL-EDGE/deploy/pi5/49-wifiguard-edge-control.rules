// Only the unprivileged local agent's one fixed capture unit. No shell/sudo.
polkit.addRule(function(action, subject) {
    if (subject.user === "wifiguard" && action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit === "wifiguard-pi5-edge.service" &&
            (verb === "start" || verb === "stop" || verb === "restart")) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }
});
