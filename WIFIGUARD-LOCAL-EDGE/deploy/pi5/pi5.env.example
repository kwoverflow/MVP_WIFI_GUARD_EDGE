# Install privately at /etc/wifiguard/pi5.env, mode 0600. Never commit real keys.
JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_KEY
LOCAL_EDGE_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTE_OR_LONGER_KEY
# Optional fallback only. GUI SPI binding in device-binding.json takes priority.
LOCAL_DEVICE_ID=REPLACE_WITH_REGISTERED_DEVICE_UUID
LOCAL_TENANT_ID=home-REPLACE_WITH_USER_UUID_OR_FACILITY_UUID
PI5_STATE_DIR=/var/lib/wifiguard-pi5
PI5_POSTGRES_UNIT=postgresql@16-main.service
# Explicit new input policy; accuracy equivalence to training is NOT established.
# Roll back with training-fixed and PRESENCE_WANDER_STRIDE_SECONDS=0.5.
MODEL_CARRIER_SELECTION=q-top30
PRESENCE_WANDER_STRIDE_SECONDS=1
MODEL_STRIDE_SECONDS=0.5
MODEL_THREADS=1
# One model worker is not whole-stack CPU affinity. Production may use all 4 cores.
DATABASE_URL=postgresql+psycopg://wifiguard_pi5:REPLACE_PASSWORD@127.0.0.1:5432/wifiguard_pi5
PG_DSN=postgresql://wifiguard_pi5:REPLACE_PASSWORD@127.0.0.1:5432/wifiguard_pi5
TSDB_DSN=postgresql://wifiguard_pi5:REPLACE_PASSWORD@127.0.0.1:5432/wifiguard_pi5_ts
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=1
PRESENCE_BATCH_SIZE=40
PRESENCE_FLUSH_INTERVAL_S=1
DEVICE_OFFLINE_AFTER_S=5
ALLOW_FALL_SIMULATE=0
PC_SIMULATION_MODE=0
PI5_CONTROL_ENABLED=1
MQTT_HOST=
KAFKA_BOOTSTRAP=
# External email/push require the original PR SMTP/recipient configuration.
# No passwords are baked into the model, reports or frontend build.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Enable only after installing the matching project's private key and registering
# each phone with the authenticated Android app. No key is shipped in the release.
MOBILE_PUSH_ENABLED=0
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/etc/wifiguard/firebase-service-account.json
MOBILE_PC_TEST_PUSH_ENABLED=0
MOBILE_PC_TEST_PUSH_EXPIRES_AT=
